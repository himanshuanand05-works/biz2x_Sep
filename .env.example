# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# SECURITY & CORS SETTINGS
# ==========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret key for signing session tokens / JWTs
JWT_SECRET=super_secret_financial_wellness_key_2026

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window per user

# ==========================================
# FILE UPLOAD LIMITS
# ==========================================
MAX_FILE_SIZE_BYTES=5242880  # 5 MB Limit (5 * 1024 * 1024)

# ==========================================
# AI / LLM SERVICE PROVIDER CONFIGURATION
# ==========================================
# Gemini / OpenAI API Credentials
LLM_PROVIDER=gemini           # Options: gemini | openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-pro       # Model target