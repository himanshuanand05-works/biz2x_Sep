# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# SECURITY & CORS SETTINGS
# ==========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret key for signing session tokens / JWTs — never commit a real secret
JWT_SECRET=change_me_in_local_dotenv
JWT_ISSUER=local-idp
JWT_AUDIENCE=financial-wellness-api
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# ==========================================
# DATABASE (Sequelize)
# ==========================================
# sqlite | postgres — prototype defaults to in-memory SQLite
DB_DIALECT=sqlite
# :memory: is non-durable (process restart wipes data). Use a file path for local persistence.
DB_STORAGE=:memory:
# Used only when DB_DIALECT=postgres
DATABASE_URL=postgres://user:pass@localhost:5432/financial_wellness

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ASSISTANT_MAX=20
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_AUTH_MAX=10

# ==========================================
# FILE UPLOAD LIMITS
# ==========================================
MAX_FILE_SIZE_BYTES=5242880

# ==========================================
# AI / LLM SERVICE PROVIDER CONFIGURATION
# ==========================================
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.3
